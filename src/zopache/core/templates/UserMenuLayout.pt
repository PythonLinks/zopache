<!DOCTYPE html>
<html lang="en">
  <head>
    <base href="${view.getSiteRoot().basePath}">
    ${structure: view.headerScripts()}
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta charset="utf-8" />
    <title>${view.title}</title>
    <meta name="viewport"
      content="width=device-width, initial-scale=1.0,
               interactive-widget=resizes-content"  >
    
    <meta name="description" content="" />
    <style>
      @media (max-width: 767px) {
          body {
           padding-bottom: 50vh;
           }
      }
    </style>  
  </head>
  <body class="bg-light" tal:define= "pug view.layoutAcquire('navbar.py') ">
    ${structure:  pug(view, pug = pug)}
    <div style = "padding-left: 20px;">
      ${structure: view.layoutAcquire('breadcrumbs')(view=view)}


    <div class="container">
      <div class="img-fluid" style="float:left; margin:20px">
	<a href ="https://ForestWiki.com">
      <img src="/Logo150W" width="150"
	   ></a>	  
      </div>
      <center>
      <h1>${view.acquireTitle()}</h1>
      <h2>${view.subTitle}</h2>
      </center>
    </div>    
     
    <a name="content"></a>
     <a name="manage"></a>
    <div id="wrapper" style= "clear:left">
      <div class="container" id="page-content-wrapper">
	<div id="main">
	  <div id="content">
            <center>
              <span style = "color:red">
		${structure: view.submissionError}
	      </span>
            </center>
	    <div tal:condition="hasattr(view,'error')"
		 style="color:red;">${view.error} </div>
	  <div tal:replace="structure content" style = "clear:left">
	  </div>
	</div>
      </div>
      
      <div id="footer">
	${structure: view.footerScripts()}
      </div>
    </div>
    </div>
  </body>
</html>
    
